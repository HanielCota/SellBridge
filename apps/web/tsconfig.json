{
  "extends": "@sellbridge/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
