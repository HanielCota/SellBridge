# Banco e filas (docker compose up -d)
DATABASE_URL=postgres://sellbridge:sellbridge@localhost:5432/sellbridge
REDIS_URL=redis://localhost:6379

# App
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Outros endereços onde o app também abre (separados por vírgula), ex.: http://127.0.0.1:3000.
# Login e conexão de lojas continuam no endereço usado, em vez de pular para APP_URL.
# BETTER_AUTH_TRUSTED_ORIGINS=
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# Chave AES-256-GCM (32 bytes em base64). Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Prévia de lucro: comissão estimada do Mercado Livre (basis points) e margem mínima do preço
# depois das taxas (%). O frete vem da tabela oficial de cada marketplace, no código.
ESTIMATED_MARKETPLACE_FEE_BASIS_POINTS=1400
MIN_MARGIN_PERCENT=0

# Armazenamento de anexos (desenvolvimento: disco local)
UPLOADS_DIR=./uploads

# E-mail do primeiro administrador (recebe role admin ao se cadastrar)
ADMIN_EMAILS=admin@sellbridge.local

# E-mail transacional (redefinição de senha) via Resend: https://resend.com
# Sem RESEND_API_KEY, em desenvolvimento o e-mail (com o link) aparece no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="SellBridge <no-reply@sellbridge.local>"

# Login com Google (opcional). Crie um OAuth Client em https://console.cloud.google.com/apis/credentials
# com o redirect {BETTER_AUTH_URL}/api/auth/callback/google. Sem as duas variáveis, o botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Livre: crie o app em https://developers.mercadolivre.com.br e use como redirect
# {APP_URL}/api/oauth/mercado_livre/callback e como URL de notificações {APP_URL}/api/webhooks/mercado_livre
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=

# Shopee: crie o app (categoria ERP System) em https://open.shopee.com > Console. Domínio de retorno
# {APP_URL}, redirect {APP_URL}/api/oauth/shopee/callback e Push {APP_URL}/api/webhooks/shopee.
# A chave do sandbox é outra que a de produção: com SHOPEE_SANDBOX=true usa os endereços de teste.
# Sem ID e chave, a Shopee aparece como "Em breve".
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SANDBOX=false

# TikTok Shop: crie o app no Partner Center (https://partner.tiktokshop.com) e use como Redirect URL
# {APP_URL}/api/oauth/tiktok_shop/callback e como webhook {APP_URL}/api/webhooks/tiktok_shop.
# O Service ID aparece na página do app. Sem os três, o TikTok Shop aparece como "Em breve".
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=

# Bling (ERP do fornecedor): crie o aplicativo na Central de Extensões > Área do Integrador
# com o link de redirecionamento {APP_URL}/api/integracoes/bling/retorno
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Mercado Pago (repasse ao fornecedor): DESLIGADO NO CÓDIGO desde 18/11/2026, o fornecedor recebe
# só pelo Asaas (MERCADO_PAGO_SUPPLIER_PAYMENTS_ON em packages/payments). Estas variáveis não ligam nada.
# Para religar: crie o aplicativo de marketplace em
# https://www.mercadopago.com.br/developers/panel/app, com o redirect
# {APP_URL}/api/integracoes/mercado-pago/retorno e as notificações de pagamento em
# {APP_URL}/api/webhooks/mercado-pago. Sem as três variáveis, o pagamento pelo SellBridge fica desligado.
# MERCADO_PAGO_TEST_MODE=true pede credenciais de teste ao ligar a conta (só com usuários de teste; recusado em produção).
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_MODE=false

# Asaas (repasse com proteção: dinheiro retido até a entrega, Conta Escrow). A conta do SellBridge
# precisa ser CNPJ, com o Split ligado (Integrações > Segurança) e a Conta Escrow liberada pelo Asaas.
# ASAAS_API_URL: https://api.asaas.com/v3 (produção, o padrão) ou https://api-sandbox.asaas.com/v3 (testes).
# ASAAS_WALLET_ID: a carteira do SellBridge, que recebe a taxa no split de cada cobrança.
# ASAAS_WEBHOOK_TOKEN: 32 a 255 caracteres sem espaços, inventado por você; não use uma chave do Asaas.
# Sem as três variáveis (chave, carteira e token), o repasse com proteção fica desligado.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=

# Consulta pública do CNPJ (aprovação do fornecedor que se cadastra sozinho). Padrão: BrasilAPI
# (https://brasilapi.com.br/api/cnpj/v1), grátis e sem chave. Só mude para apontar a um substituto de teste.
# CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1

# Shopee (futuro)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Worker: sellable units per product kept off the marketplaces (0 = offer everything sellable).
STOCK_SAFETY_UNITS=0
# Worker: units Shopee listings show on top of the real ones (0 to 100000; 0 = off). Shopee only
# boosts listings from 1000 units up. With 0 real units the listing gets 0 and stops selling.
SHOPEE_SHOWCASE_UNITS=1000
WORKER_CONCURRENCY=5

# Carrier tracking remains disconnected until a real integration is configured.
CARRIER_TRACKING_PROVIDER=off

# Webhooks da API pública: permite endpoints em localhost/rede privada (somente desenvolvimento).
# Em produção deixe false: senão um cliente poderia fazer o servidor chamar serviços internos.
WEBHOOK_ALLOW_PRIVATE_URLS=true

# Recusa senhas que aparecem em vazamentos (Have I Been Pwned, item 30.c): auto = só em produção.
LEAKED_PASSWORD_CHECK=auto

# Resposta automática do suporte antes do chamado: faq (respostas locais) | deepseek (ainda não
# ligado: cai para faq). Nenhuma chamada a IA é feita hoje.
SUPPORT_ASSISTANT_PROVIDER=faq

# Worker: encaminha sozinho o pedido pago aos fornecedores e manda o link por e-mail (item 21.b).
# Desligado por padrão até a decisão D6. O worker usa RESEND_API_KEY e EMAIL_FROM acima.
AUTO_FORWARD_ENABLED=false

# Logs estruturados: debug | info | warn | error
LOG_LEVEL=info

# Alertas de erro (item 32.a): webhook HTTPS de chat (Slack, Discord ou Google Chat) que recebe
# cada log de nível error, sem dados pessoais, no máximo um por evento a cada 5 minutos. Vazio = desligado.
ALERT_WEBHOOK_URL=

# Optional operator bootstrap. The normal seed creates this admin and the category taxonomy only.
# Set an actual operator email/name and a generated password before running database:seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Plans' monthly fee: charged on SellBridge's Asaas account above (the same three ASAAS_* keys)
# once both launch dates are set. Register APP_URL/api/webhooks/asaas-assinatura in that account
# (steps in docs/billing.md). Launch of the paid plans (UTC): accounts created before
# BILLING_LAUNCHED_AT keep today's access, without limits, until BILLING_TRANSITION_ENDS_AT.
# Both or neither; production with billing on requires both.
# BILLING_LAUNCHED_AT=2026-12-01T03:00:00Z
# BILLING_TRANSITION_ENDS_AT=2026-12-31T03:00:00Z
# Production refuses to start without the Asaas keys and the dates unless this says so (no plan
# limits). It also holds the plans off while the Asaas keys serve only suppliers' payments.
# BILLING_UNLIMITED=false
# Days a late monthly charge keeps the plan before the account is left without one.
# BILLING_PAST_DUE_GRACE_DAYS=7
