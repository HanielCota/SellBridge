# Banco e filas (docker compose up -d)
DATABASE_URL=postgres://sellbridge:sellbridge@localhost:5432/sellbridge
REDIS_URL=redis://localhost:6379

# App
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# Chave AES-256-GCM (32 bytes em base64). Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Taxa da plataforma em basis points (100 = 1%)
PLATFORM_FEE_BASIS_POINTS=0

# Prévia de lucro: comissão estimada do marketplace (basis points), frete pago pelo revendedor
# por venda (centavos; 0 até a decisão D5) e margem mínima do preço depois das taxas (%)
ESTIMATED_MARKETPLACE_FEE_BASIS_POINTS=1400
ESTIMATED_SHIPPING_CENTS=0
MIN_MARGIN_PERCENT=0

# Armazenamento de anexos (desenvolvimento: disco local)
UPLOADS_DIR=./uploads

# E-mail do primeiro administrador (recebe role admin ao se cadastrar)
ADMIN_EMAILS=admin@sellbridge.local

# E-mail transacional (redefinição de senha) via Resend: https://resend.com
# Sem RESEND_API_KEY, em desenvolvimento o e-mail (com o link) aparece no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="SellBridge <no-reply@sellbridge.local>"

# Login com Google (opcional). Crie um OAuth Client em https://console.cloud.google.com/apis/credentials
# com o redirect {BETTER_AUTH_URL}/api/auth/callback/google. Sem as duas variáveis, o botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Livre: crie o app em https://developers.mercadolivre.com.br e use como redirect
# {APP_URL}/api/oauth/mercado_livre/callback e como URL de notificações {APP_URL}/api/webhooks/mercado_livre
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=

# Shopee e TikTok Shop (futuro)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

# Conector simulado (desenvolvimento)
# Segredo HMAC dos webhooks simulados (16+ caracteres). Gere com: openssl rand -hex 32
MOCK_WEBHOOK_SECRET=
MOCK_LATENCY_MILLISECONDS=800
# Worker: sellable units per product kept off the marketplaces (0 = offer everything sellable).
STOCK_SAFETY_UNITS=0
WORKER_CONCURRENCY=5

# Webhooks da API pública: permite endpoints em localhost/rede privada (somente desenvolvimento).
# Em produção deixe false: senão um cliente poderia fazer o servidor chamar serviços internos.
WEBHOOK_ALLOW_PRIVATE_URLS=true

# Worker: encaminha sozinho o pedido pago aos fornecedores e manda o link por e-mail (item 21.b).
# Desligado por padrão até a decisão D6. O worker usa RESEND_API_KEY e EMAIL_FROM acima.
AUTO_FORWARD_ENABLED=false

# Logs estruturados: debug | info | warn | error
LOG_LEVEL=info

# Senhas das contas criadas pelo seed (somente desenvolvimento; usadas também pelos testes E2E)
SEED_DEMO_PASSWORD=demo12345
SEED_ADMIN_PASSWORD=admin12345

# Optional SaaS billing: all four values are required to enable checkout and plan limits.
# Create two fixed monthly recurring BRL prices in Stripe and configure the customer portal.
# Webhook: APP_URL/api/webhooks/stripe (customer.subscription.* events).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_BUSINESS_PRICE_ID=price_...
# Production refuses to start without the four values above unless this says so (no plan limits).
# BILLING_UNLIMITED=false
# Days a failed renewal (past_due) keeps the paid limits before falling back to Gratuito.
# BILLING_PAST_DUE_GRACE_DAYS=7

# Optional portal configuration scoped to SellBridge (avoid account-wide defaults).
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
