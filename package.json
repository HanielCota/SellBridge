{
  "name": "sellbridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "vitest run && turbo run test",
    "test:e2e": "pnpm --filter @sellbridge/web test:e2e",
    "check:no-else": "tsx scripts/check-no-else.ts",
    "db:up": "docker compose up -d",
    "database:generate": "pnpm --filter @sellbridge/database generate",
    "database:migrate": "pnpm --filter @sellbridge/database migrate",
    "database:seed": "pnpm --filter @sellbridge/database seed",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "lefthook": "^2.2.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
