{
  "name": "sellbridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "vitest run && turbo run test",
    "test:e2e": "pnpm --filter @sellbridge/web test:e2e",
    "check:no-else": "tsx scripts/check-no-else.ts",
    "services:up": "docker compose up -d",
    "database:generate": "pnpm --filter @sellbridge/database generate",
    "database:migrate": "pnpm --filter @sellbridge/database migrate",
    "database:seed": "pnpm --filter @sellbridge/database seed",
    "prepare": "lefthook install",
    "billing:listen": "stripe listen --config \"$HOME/.config/stripe/sellbridge-test.toml\" --forward-to localhost:3000/api/webhooks/stripe --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed,invoice.paid,invoice.payment_failed,checkout.session.completed,checkout.session.async_payment_succeeded"
  },
  "devDependencies": {
    "@stripe/cli": "^1.54.1",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
